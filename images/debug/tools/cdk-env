#!/usr/bin/env bash
#
# Dump the target process's environment with secret-looking values masked, so
# it can go straight into a support ticket.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR
# shellcheck source=./cdk-common.sh
. /usr/local/lib/conduktor/cdk-common.sh

usage() {
  cat <<EOF
Usage: cdk-env [-a] [PATTERN]

Prints the target JVM's environment, sorted, with secrets masked.

  -a          all variables (default: only CDK_*, PLATFORM_*, CONSOLE_*,
              GATEWAY_*, JAVA_*, KAFKA_*, proxy and TZ/LANG)
  PATTERN     extra case-insensitive filter on the variable name

  CDK_TARGET_PID   pin a specific pid
  CDK_NO_REDACT=1  show real values
EOF
}

all=0
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --version) cdk_version_line; exit 0 ;;
  -a) all=1; shift ;;
esac
pattern="${1:-}"

pid="$(cdk_target_pid)" || exit 1
[ -r "/proc/${pid}/environ" ] || cdk_die "cannot read /proc/${pid}/environ (uid mismatch — see cdk-target)"

vars="$(tr '\0' '\n' < "/proc/${pid}/environ" | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' | sort)"

if [ "${all}" = "0" ]; then
  vars="$(printf '%s\n' "${vars}" \
    | grep -E '^(CDK_|PLATFORM_|CONSOLE_|GATEWAY_|JAVA_|JDK_|KAFKA_|SCHEMA_|SSL_|TLS_|LDAP_|DB_|DATABASE_|POSTGRES_|HTTP_|HTTPS_|NO_PROXY|http_proxy|https_proxy|no_proxy|TZ=|LANG=|MODULE=)' || true)"
fi

if [ -n "${pattern}" ]; then
  vars="$(printf '%s\n' "${vars}" | grep -iE "^[^=]*${pattern}[^=]*=" || true)"
fi

if [ -z "${vars}" ]; then
  cdk_warn "no matching variables (try -a, or a looser PATTERN)"
  exit 0
fi

cdk_head "environment of pid ${pid}"
printf '%s\n' "${vars}" | cdk_maybe_redact
cdk_redact_note
